# Obrabi configuration. Create .env with random secrets with:
#   ./scripts/gen-env.sh
# (it copies this file and fills in every empty secret below).

# ---------------------------------------------------------------- network
# Port and address where the gateway (the web app) is published.
OBRABI_PORT=8080
OBRABI_BIND=0.0.0.0
# IPs or CIDRs of the reverse proxy in front of Obrabi (e.g. your Nginx Proxy
# Manager / Traefik / Caddy LXC on Proxmox), comma separated. Needed so that
# the login rate limit sees the real client IP. The bundled Caddy (profile
# "https") lives in OBRABI_EDGE_SUBNET, which is trusted by default.
OBRABI_TRUSTED_PROXIES=
OBRABI_EDGE_SUBNET=172.30.80.0/24
# Secure flag of the session cookie: auto (Secure whenever the request came
# over HTTPS, also through a proxy), true or false.
OBRABI_COOKIE_SECURE=auto
# Optional bundled HTTPS: public domain for `docker compose --profile https up -d`.
OBRABI_DOMAIN=

# ---------------------------------------------------------------- app
OBRABI_TIMEZONE=Europe/Madrid
# Users created on first start, each with a random password printed once in
# `docker compose logs auth`.
OBRABI_BOOTSTRAP_USERS=nando
# How long a login lasts without using the app (it renews while in use).
OBRABI_SESSION_TTL=1440h
OBRABI_LOG_LEVEL=info

# ---------------------------------------------------------------- secrets
OBRABI_SESSION_SECRET=
OBRABI_INTERNAL_TOKEN=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
PROJECTS_DB_PASSWORD=
STATS_DB_PASSWORD=
FEEDBACK_DB_PASSWORD=

# ---------------------------------------------------------------- e-mail
# Suggestions, bug reports and automatic error reports are e-mailed here.
# Google Workspace / Gmail: smtp.gmail.com:587, the account address as
# SMTP_USERNAME and an App Password (not the account password) as
# SMTP_PASSWORD. Leave SMTP_HOST empty to disable e-mails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OBRABI_REPORT_EMAIL_TO=lucabodd@gmail.com

# ---------------------------------------------------------------- backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30
